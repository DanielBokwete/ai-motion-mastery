{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "daniel-ia-marketer.vercel.app" }], "destination": "/formations" },
    { "source": "/", "destination": "/ai-motion-mastery" },
    { "source": "/acces", "destination": "/ai-motion-mastery/merci" }
  ],
  "headers": [
    { "source": "/videos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/acces", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(.*)/merci", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
